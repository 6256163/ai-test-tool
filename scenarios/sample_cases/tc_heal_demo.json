{
  "id": "TC_HEAL_DEMO",
  "title": "演示 Healer：搜索后断言/点击商品（故意漏 index，触发 strict mode）",
  "preconditions": ["被测系统已部署，登录页可访问", "存在可搜索的产品「旗舰版」"],
  "steps": [
    { "action": "navigate", "locator": null, "value": "/login", "expect": null, "note": "打开登录页" },
    { "action": "fill", "locator": { "by": "testid", "value": "input-username" }, "value": "admin", "expect": null, "note": "输入用户名 admin" },
    { "action": "fill", "locator": { "by": "testid", "value": "input-password" }, "value": "admin123", "expect": null, "note": "输入密码 admin123" },
    { "action": "click", "locator": { "by": "testid", "value": "btn-login" }, "expect": null, "note": "点击登录按钮" },
    { "action": "assert_text", "locator": { "by": "testid", "value": "current-user" }, "value": null, "expect": "admin", "note": "校验登录成功" },
    { "action": "fill", "locator": { "by": "testid", "value": "input-keyword" }, "value": "旗舰版", "expect": null, "note": "输入搜索关键字" },
    { "action": "click", "locator": { "by": "testid", "value": "btn-search" }, "expect": null, "note": "点击搜索" },
    { "action": "assert_text", "locator": { "by": "testid", "value": "product-name" }, "value": null, "expect": "旗舰版", "note": "断言搜索结果出现旗舰版（故意漏 index）" },
    { "action": "click", "locator": { "by": "testid", "value": "product-name" }, "value": null, "expect": null, "note": "点击第一个商品（故意漏 index）" },
    { "action": "assert_text", "locator": { "by": "testid", "value": "detail-name" }, "value": null, "expect": "旗舰版", "note": "校验进入详情页" }
  ],
  "coverage_tags": ["主流程", "回归"],
  "target_framework": "playwright",
  "base_path": "/login"
}
